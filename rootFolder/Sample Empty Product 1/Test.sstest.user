<?xml version="1.0" encoding="utf-8"?>
<UserSettings>
  <ArrayOfFlexDictionaryEntry xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <FlexDictionaryEntry name="Debugger" type="SmarteStudio.Test.FlexDictionary">
      <FlexDictionary>
        <ArrayOfFlexDictionaryEntry>
          <FlexDictionaryEntry name="DebugMode" type="System.String">
            <string>NoDebugger</string>
          </FlexDictionaryEntry>
          <FlexDictionaryEntry name="Verbose" type="System.Int32">
            <int>1</int>
          </FlexDictionaryEntry>
        </ArrayOfFlexDictionaryEntry>
      </FlexDictionary>
    </FlexDictionaryEntry>
    <FlexDictionaryEntry name="ActiveDocument" type="SmarteStudio.Test.FlexDictionary">
      <FlexDictionary>
        <ArrayOfFlexDictionaryEntry />
      </FlexDictionary>
    </FlexDictionaryEntry>
    <FlexDictionaryEntry name="OpenDocuments" type="SmarteStudio.Test.StringList">
      <ArrayOfString />
    </FlexDictionaryEntry>
  </ArrayOfFlexDictionaryEntry>
</UserSettings>